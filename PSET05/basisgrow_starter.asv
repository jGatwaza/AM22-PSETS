%write your code below

% start with empty basis
B = [];

% iterate over each vector in V
for i = 1:size(V, 1)
    % get the i-th vector 
    % transpose it to a column vector
    v = V(i, :)';

    % if B is empty, initialize it with the first vector
    if isempty(B)
        B = v;
     % append the new vector to B 
    else
        M = [B, v];
        if islinearlyindependent(M)
            % If the set remains linearly independent, update B
            B = M;
        end
    end
end

% Print out the basis
disp('The basis is:');
disp(B);

% Output the dimension of V
fprintf('The dimension of V is %d\n', size(B, 2));
